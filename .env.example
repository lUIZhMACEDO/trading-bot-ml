# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Alpaca paper trading keys (https://app.alpaca.markets -> Paper Trading -> API Keys).
# The bot only ever talks to the paper endpoint; there is no live-trading setting.
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# Optional. Free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# SQLite file for prices, indicators, signals and the trade log
DB_PATH=trading_bot.db

# Auto-trader defaults (the dashboard form can override these per run)
MAX_BUDGET=10000
MAX_POSITIONS=3
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=5.0
SCAN_INTERVAL_SECONDS=60

# Cost model in basis points of notional, used by the backtester and the trade log
TX_COST_BPS=5
SLIPPAGE_BPS=2

# Dashboard server. Keep it on 127.0.0.1: it can place orders and has no login.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
